QMainWindow {
    background-color: #1e1e1e;
}

QListWidget {
    background-color: #252526;
    color: #ffffff;
    border: none;
    padding: 10px;
}

QLabel {
    color: #ffffff;
    font-size: 18px;
}

QPushButton {
    background-color: #333333;
    color: #ffffff;
    border: none;
    padding: 10px 18px;
    border-radius: 6px;
}

QPushButton:hover {
    background-color: #444444;
}

QPushButton:pressed {
    background-color: #222222;
}