/* ==============================
   MAIN WINDOW
   ============================== */

QMainWindow {
    background-color: #181a1f;
}


/* ==============================
   GENERAL WIDGETS
   ============================== */

QWidget {
    color: #e6e6e6;
    font-family: "Segoe UI";
    font-size: 14px;
}


/* ==============================
   SECTION TITLE
   ============================== */

QLabel#sectionTitle {
    color: #8b949e;
    font-size: 12px;
    font-weight: bold;
}


/* ==============================
   CASE LIST
   ============================== */

QListWidget#caseList {
    background-color: #20232a;
    border: 1px solid #30343b;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}

QListWidget#caseList::item {
    padding: 14px;
    border-radius: 6px;
}

QListWidget#caseList::item:hover {
    background-color: #2a2e36;
}

QListWidget#caseList::item:selected {
    background-color: #343a46;
    color: white;
}


/* ==============================
   CASE TITLE
   ============================== */

QLabel#caseTitle {
    color: white;
    font-size: 28px;
    font-weight: bold;
}

QLabel#caseDescription {
    color: #9da4ad;
    font-size: 15px;
}


/* ==============================
   PRIMARY BUTTON
   ============================== */

QPushButton#primaryButton {
    background-color: #3b82f6;
    color: white;

    border: none;
    border-radius: 7px;

    padding: 12px 18px;

    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #2563eb;
}

QPushButton#primaryButton:pressed {
    background-color: #1d4ed8;
}


/* ==============================
   CASE FORM
   ============================== */

QDialog {
    background-color: #181a1f;
}

QLineEdit,
QComboBox,
QTextEdit {
    background-color: #20232a;

    color: #e6e6e6;

    border: 1px solid #30343b;
    border-radius: 6px;

    padding: 9px;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 1px solid #3b82f6;
}


/* Combo Box */

QComboBox {
    padding-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #20232a;
    color: #e6e6e6;

    border: 1px solid #30343b;
    selection-background-color: #343a46;
}


/* Secondary Button */

QPushButton#secondaryButton {
    background-color: #2a2e36;
    color: #e6e6e6;

    border: 1px solid #3a3f48;
    border-radius: 7px;

    padding: 10px 18px;
}

QPushButton#secondaryButton:hover {
    background-color: #343a46;
}

QPushButton#secondaryButton:pressed {
    background-color: #22252b;
}

/* ==============================
   CASE DETAILS
   ============================== */

QLabel#caseType {
    color: #8b949e;
    font-size: 14px;
}

QLabel#caseDescription {
    color: #b8bec7;
    font-size: 15px;
    line-height: 1.5;
}

QLabel#caseStatus {
    color: #6ee7b7;
    font-size: 14px;
    font-weight: bold;
}

QLabel#caseInfo {
    color: #9da4ad;
    font-size: 14px;
}

QLabel#caseId {
    color: #636b76;
    font-size: 12px;
}


/* ==============================
   DANGER BUTTON
   ============================== */

QPushButton#dangerButton {
    background-color: #7f1d1d;
    color: white;

    border: none;
    border-radius: 7px;

    padding: 10px 18px;
}

QPushButton#dangerButton:hover {
    background-color: #991b1b;
}

QPushButton#dangerButton:pressed {
    background-color: #651414;
}

QPushButton#dangerButton:disabled,
QPushButton#secondaryButton:disabled,
QPushButton#primaryButton:disabled {
    background-color: #292c32;
    color: #5f6670;
}
