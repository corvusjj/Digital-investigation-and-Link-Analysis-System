/* ==============================
   MAIN WINDOW
   ============================== */

QMainWindow {
    background-color: #181a1f;
}


/* ==============================
   GENERAL WIDGETS
   ============================== */

QWidget {
    color: #e6e6e6;
    font-family: "Segoe UI";
    font-size: 14px;
}


/* ==============================
   SECTION TITLE
   ============================== */

QLabel#sectionTitle {
    color: #8b949e;
    font-size: 12px;
    font-weight: bold;
}


/* ==============================
   CASE LIST
   ============================== */

QListWidget#caseList {
    background-color: #20232a;
    border: 1px solid #30343b;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}

QListWidget#caseList::item {
    padding: 14px;
    border-radius: 6px;
}

QListWidget#caseList::item:hover {
    background-color: #2a2e36;
}

QListWidget#caseList::item:selected {
    background-color: #343a46;
    color: white;
}


/* ==============================
   CASE TITLE
   ============================== */

QLabel#caseTitle {
    color: white;
    font-size: 28px;
    font-weight: bold;
}

QLabel#caseDescription {
    color: #9da4ad;
    font-size: 15px;
}


/* ==============================
   PRIMARY BUTTON
   ============================== */

QPushButton#primaryButton {
    background-color: #3b82f6;
    color: white;

    border: none;
    border-radius: 7px;

    padding: 12px 18px;

    font-weight: bold;
}

QPushButton#primaryButton:hover {
    background-color: #2563eb;
}

QPushButton#primaryButton:pressed {
    background-color: #1d4ed8;
}
